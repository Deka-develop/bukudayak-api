# ==========================================
# KONFIGURASI BACKEND API BUKUDAYAK.COM
# ==========================================

# Port server untuk local development
PORT=3000

# URL Frontend (untuk keamanan CORS, pisahkan dengan koma jika lebih dari 1)
ALLOWED_ORIGINS=https://bukudayak.com,https://www.bukudayak.com,http://localhost:3000,http://127.0.0.1:5500

# ------------------------------------------
# 1. MAYAR.ID PAYMENT GATEWAY
# ------------------------------------------
# Dapatkan API Key di: https://web.mayar.id/api-keys (Pilih Read & Write)
MAYAR_API_KEY=your_mayar_api_key_here
# Mode: "production" atau "sandbox"
MAYAR_MODE=production
# URL Redirect setelah pembeli sukses bayar
MAYAR_REDIRECT_URL=https://bukudayak.com/?status=payment_success

# ------------------------------------------
# 2. SISTEM ONGKOS KIRIM (RAJAONGKIR / BITESHIP)
# ------------------------------------------
# Pilihan provider: "rajaongkir" atau "biteship" atau "fallback"
SHIPPING_PROVIDER=rajaongkir

# Jika menggunakan RajaOngkir (https://rajaongkir.com):
# Tipe akun: "starter" atau "basic" atau "pro"
RAJAONGKIR_ACCOUNT_TYPE=starter
RAJAONGKIR_API_KEY=your_rajaongkir_api_key_here
# ID Kota Asal Pengiriman (Default: 501 = Kota Yogyakarta, 364 = Kota Pontianak, 326 = Palangka Raya)
ORIGIN_CITY_ID=501

# Jika menggunakan Biteship (https://biteship.com):
BITESHIP_API_KEY=your_biteship_api_key_here
BITESHIP_ORIGIN_AREA_ID=IDNP5IDJB709

# Default berat per buku jika tidak dispesifikasikan (dalam gram)
DEFAULT_BOOK_WEIGHT_GRAMS=400
